{
  "name": "RehearsalBlock",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM format"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM format"
    },
    "studio_id": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "piece_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of pieces in this rehearsal"
    },
    "dancer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific dancers called for this rehearsal"
    }
  },
  "required": [
    "date",
    "start_time",
    "end_time"
  ]
}